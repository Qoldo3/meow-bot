{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meow-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",

  // Runs every minute to clean up expired duels.
  // This is the reliable backstop for the in-request setTimeout() paths.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "vars": {
    // Optional: a user id that gets boosted meow tier chances (leave empty to disable).
    "MEOW_VIP_USER_ID": "1328716728"
  },

  // Optional: enables the 30s active-event cache (see getActiveEvent in handlers.ts).
  // Create a KV namespace and uncomment:
  // "kv_namespaces": [
  //   { "binding": "CACHE", "id": "<kv-namespace-id>" }
  // ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meow-bot-db",
      "database_id": "9c2f5180-7d44-4446-9a31-ff37d73e4b0e"
    }
  ],

  // Durable Objects hosting in-group card games. One instance per game id.
  "durable_objects": {
    "bindings": [
      { "name": "POKER_GAME", "class_name": "PokerGame" },
      { "name": "BLACKJACK_GAME", "class_name": "BlackjackGame" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HokmGame"] },
    { "tag": "v2", "new_sqlite_classes": ["PokerGame"] },
    { "tag": "v3", "deleted_classes": ["HokmGame"] },
    { "tag": "v4", "new_sqlite_classes": ["BlackjackGame"] }
  ]
}
